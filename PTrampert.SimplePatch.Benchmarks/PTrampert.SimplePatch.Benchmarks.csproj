<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
          net10.0 rather than the core package's net8.0: global.json pins the .NET 10 SDK, and CI
          installs no other runtime for BenchmarkDotNet to launch its benchmark processes on.
        -->
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\PTrampert.SimplePatch\PTrampert.SimplePatch.csproj" />
    </ItemGroup>

</Project>
