<Project Sdk="Microsoft.NET.Sdk">

    <!-- A second assembly for PTrampert.SimplePatch.Test, so a patch source type can have a
         non-public property type from an assembly other than its own. -->
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="PTrampert.SimplePatch.Test" />
    </ItemGroup>

</Project>
