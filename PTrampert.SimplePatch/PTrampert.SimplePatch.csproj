<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <Authors>pjt15253</Authors>
        <Description>Provides a generic Optional record type and JsonConverter for use in PATCH operations.</Description>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/PaulTrampert/PTrampert.SimplePatch</PackageProjectUrl>
        <PackageReleaseNotes>https://github.com/PaulTrampert/PTrampert.SimplePatch/releases</PackageReleaseNotes>
        <RepositoryUrl>https://github.com/PaulTrampert/PTrampert.SimplePatch.git</RepositoryUrl>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <!-- Lets the tests reach PatchClassModel and the other internals directly. -->
        <InternalsVisibleTo Include="PTrampert.SimplePatch.Test" />
    </ItemGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="" />
    </ItemGroup>
    
    <ItemGroup>
      <!-- Only RoslynPatchClassBuilder uses these. It is unused at runtime, but kept pending #144. -->
      <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
      <PackageReference Include="System.CodeDom" Version="10.0.12" />
    </ItemGroup>

</Project>
